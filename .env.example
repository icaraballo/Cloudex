# Copia este archivo a .env y rellénalo. .env NO se sube a Git.

# --- Cliente (la web). Las variables VITE_* acaban en el navegador, así que
# --- aquí NUNCA va una clave secreta.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Clave pública (anon) que enseña `npx supabase status` con Supabase local.
VITE_SUPABASE_ANON_KEY=

# --- Servidor (Edge Function `analizar`). Van en supabase/functions/.env,
# --- nunca en la web. Se documentan aquí para tenerlas todas juntas.
# Proveedor de IA: mock | gemini | ollama | anthropic  (por defecto, mock)
IA_PROVEEDOR=mock
# Solo si IA_PROVEEDOR=gemini
GEMINI_API_KEY=
# Solo si IA_PROVEEDOR=anthropic
ANTHROPIC_API_KEY=
# Solo si IA_PROVEEDOR=ollama
OLLAMA_URL=http://127.0.0.1:11434
# Análisis por usuario y día (hora de Madrid)
LIMITE_DIARIO=10
